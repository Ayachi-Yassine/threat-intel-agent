# --- Groq ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=groq/openai/gpt-oss-120b

# --- Ubuntu Action Agent (autonomous) ---
# The Action Agent hands off a summary here; Ubuntu's own AI decides and
# executes. Key must match AGENT_API_KEY in Ubuntu's /etc/ubuntu-action-agent/agent.env
UBUNTU_AGENT_URL=http://192.168.111.139:9100
UBUNTU_AGENT_API_KEY=paste_the_same_key_you_set_in_agent.env_on_ubuntu

# --- Neo4j ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# --- Safety ---
# ACTION_RISK_THRESHOLD still gates whether the incident is handed off to
# Ubuntu at all. Ubuntu's own DRY_RUN (separate, in its own agent.env)
# gates whether IT actually executes once it decides.
ACTION_RISK_THRESHOLD=7

# --- Webhook server ---
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8000
